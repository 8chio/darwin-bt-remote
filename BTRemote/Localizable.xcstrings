    "settings.force_service_changed_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Force a connected device to re-detect services as a workaround for stale GATT cache. Required for initial pairing with Android devices."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 기기가 서비스를 다시 검색하도록 하여 오래된 GATT 캐시 문제를 해결합니다. Android 기기와 처음 페어링할 때 필요합니다."
          }
        }
      }
    },
    "settings.reset": {
      "extractionState": "manual",
