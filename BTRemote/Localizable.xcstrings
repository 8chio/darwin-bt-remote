    "setup.active_legend": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "✓ indicates the device is active and subscribed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "✓는 활성 상태로 구독 중인 기기를 나타냅니다."
          }
        }
      }
    },
    "setup.bluetooth_off_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth must be on to proceed. Enable it and try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하려면 Bluetooth가 켜져 있어야 합니다. 켠 후 다시 시도하세요."
          }
        }
      }
    },
    "setup.bluetooth_off_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn On Bluetooth"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth 켜기"
          }
        }
      }
    },
    "setup.classic_guide": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth Classic Guide"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth Classic 안내"
          }
        }
      }
    },
    "setup.classic_step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under Paired Devices, click \"Pair New Device\", or pair from System Settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링된 기기에서 “새 기기 페어링”을 클릭하거나 시스템 설정에서 페어링하세요."
          }
        }
      }
    },
    "setup.classic_step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the device you want to use in the window that appears. Make sure the target device is discoverable by going to the Bluetooth screen on the target device."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나타나는 창에서 사용할 기기를 선택하세요. 대상 기기의 Bluetooth 화면을 열어 검색 가능한 상태인지 확인하세요."
          }
        }
      }
    },
    "setup.classic_step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select \"Connect\" to establish a connection. You may need to wait a few seconds before it activates. Occasionally you may need to try again by clicking \"Connect\" a second time to activate a stable connection."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“연결”을 선택해 연결하세요. 활성화되기까지 몇 초 걸릴 수 있습니다. 안정적으로 연결하려면 “연결”을 한 번 더 클릭해야 할 수도 있습니다."
          }
        }
      }
    },
    "setup.classic_troubleshooting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the device still does not respond, remove the pairing on both this device and the target device, then pair again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기가 계속 반응하지 않으면 이 기기와 대상 기기 양쪽에서 페어링을 삭제한 후 다시 페어링하세요."
          }
        }
      }
    },
    "setup.advertised_name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advertised Name"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광고 이름"
          }
        }
      }
    },
    "setup.advertised_name_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name other devices see. For best compatibility, keep it to 8 characters or fewer."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에 표시되는 이름입니다. 호환성을 위해 8자 이하를 권장합니다."
          }
        }
      }
    },
    "setup.device_name_limitation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Due to platform limitations, the name of the target device cannot be displayed unless it has previously been paired with this device."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플랫폼 제한으로 인해 이 기기와 이전에 페어링한 적이 없는 대상 기기의 이름은 표시할 수 없습니다."
          }
        }
      }
    },
    "setup.connect_from_target_device": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect from the target device"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상 기기에서 연결"
          }
        }
      }
    },
    "setup.connect_from_this_app": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect from this application"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱에서 연결"
          }
        }
      }
    },
    "setup.find_guide_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can find this guide at the top of the \"Setup\" tab."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 안내는 “연결 설정” 탭 상단에서 다시 볼 수 있습니다."
          }
        }
      }
    },
    "setup.from_app": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple devices (same Apple Account)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 기기 (동일한 Apple 계정)"
          }
        }
      }
    },
    "setup.from_app_step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap \"Scan\" under Devices."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 항목에서 “검색”을 누르세요."
          }
        }
      }
    },
    "setup.from_app_step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the device to connect. You may also identify a device by using the information button."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결할 기기를 누르세요. 정보 버튼으로 기기를 확인할 수도 있습니다."
          }
        }
      }
    },
    "setup.from_device": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All other devices"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 외 모든 기기"
          }
        }
      }
    },
    "setup.from_device_step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensure this application is open and advertising. You can check this in \"Status\" within the \"Setup\" tab."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱이 열려 있고 광고 중인지 확인하세요. “연결 설정” 탭의 “상태”에서 확인할 수 있습니다."
          }
        }
      }
    },
    "setup.from_device_step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the target device, open Bluetooth settings and pair with \"%@\" or this device's Bluetooth name."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상 기기의 Bluetooth 설정에서 “%@” 또는 이 기기의 Bluetooth 이름으로 페어링하세요."
          }
        }
      }
    },
    "setup.from_device_step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select \"Pair\" or \"Connect\" on the target device first, then confirm with \"Pair\" on this device."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상 기기에서 먼저 “페어링” 또는 “연결”을 선택한 다음 이 기기에서 “페어링”을 확인하세요."
          }
        }
      }
    },
    "setup.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도움말"
          }
        }
      }
    },
    "setup.icloud_paired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Devices paired over iCloud will not show up in iOS Settings > Bluetooth."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud로 페어링된 기기는 iOS 설정 > Bluetooth에 표시되지 않습니다."
          }
        }
      }
    },
    "setup.le_guide": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth Low Energy Guide"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth Low Energy 안내"
          }
        }
      }
    },
    "setup.troubleshooting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If there is no response on the target, forget the pairing on both devices in their respective Settings, turn Bluetooth off and on, and then initiate pairing again from the target device."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상 기기가 반응하지 않으면 양쪽 기기의 설정에서 페어링을 삭제하고 Bluetooth를 껐다 켠 다음 대상 기기에서 다시 페어링하세요."
          }
        }
      }
    },
    "setup.video_instructions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video Instructions"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상 안내"
          }
        }
      }
    },
    "sort.ascending": {
      "extractionState": "manual",
      "localizations": {
