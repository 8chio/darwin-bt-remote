            "state": "translated",
            "value": "빠르게 두 번 탭한 뒤 누른 채 드래그합니다. 한 번 클릭할 때 방해가 되면 끄세요."
          }
        }
      }
    },
    "shortcut.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct Input Shortcut"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct Input 단축키"
          }
        }
      }
    },
    "shortcut.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record a shortcut with Control, Option, or Command and a key. The same shortcut starts and stops Direct Input. Control + Option always releases capture. You can also start from Setup without a shortcut."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Control, Option 또는 Command와 키를 조합하세요. 같은 단축키로 Direct Input을 시작·종료합니다. Control + Option은 항상 비상 종료합니다. 단축키 없이도 설정 화면에서 시작할 수 있습니다."
          }
        }
      }
    },
    "shortcut.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record Shortcut…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키 지정…"
          }
        }
      }
    },
    "shortcut.recording": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press shortcut (Esc to cancel)…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키를 누르세요 (Esc로 취소)…"
          }
        }
      }
    },
    "shortcut.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
