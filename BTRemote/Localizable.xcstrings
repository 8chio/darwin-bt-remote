    "device_info.remove_services_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes all published HID services and drops every connected host. Tap Start Advertising to republish."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게시된 모든 HID 서비스를 제거하고 연결된 모든 호스트의 연결을 끊습니다. 다시 게시하려면 광고 시작을 누르세요."
          }
